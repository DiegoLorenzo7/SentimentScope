{
  "name": "sentiment-scope",
  "displayName": "SentimentScope",
  "version": "1.0.0",
  "description": "Interactive browser-based sentiment analysis extension",
  "author": "Diego Lorenzo Roviralta",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "chart.js": "^4.4.2",
    "chartjs-plugin-datalabels": "^2.2.0",
    "plasmo": "0.86.0",
    "react": "18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.33.3",
    "tailwindcss": "3.4.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.19",
    "postcss": "8.4.33",
    "prettier": "3.2.4",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "<all_urls>"
    ],
    "permissions": [
      "activeTab",
      "contextMenus",
      "tabs",
      "storage"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "*.png",
          "src/features/emoji.png",
          "src/features/vader_lexicon.txt"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  }
}